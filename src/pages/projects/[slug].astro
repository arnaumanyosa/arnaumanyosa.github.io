---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/project-detail/ProjectHero.astro';
import ProjectMeta from '../../components/project-detail/ProjectMeta.astro';
import ProjectOutcomes from '../../components/project-detail/ProjectOutcomes.astro';
import ProjectBody from '../../components/project-detail/ProjectBody.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, subtitle, thumbnail, techstack, period, roles, liveUrl, overview, outcomes } =
  project.data;

const { Content } = await render(project);
---

<BaseLayout title={`${title} — Portfolio`} description={overview} isProjectDetails>
  <article class="py-16 px-6 max-w-4xl mx-auto">
    <ProjectHero
      title={title}
      subtitle={subtitle}
      thumbnail={thumbnail}
      period={period}
      liveUrl={liveUrl}
    />
    <ProjectMeta techstack={techstack} roles={roles} overview={overview} />
    <ProjectOutcomes outcomes={outcomes} />
    <ProjectBody>
      <Content />
    </ProjectBody>
  </article>
</BaseLayout>
