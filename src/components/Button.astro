---
interface Props {
  href: string;
  download?: boolean;
  target?: string;
  rel?: string;
}

const { href, download, target, rel } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-2 font-body  text-sm px-4 py-2 rounded border border-subtle text-body transition-colors hover:bg-heading hover:border-heading hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border"
  download={download}
  target={target}
  rel={rel}
>
  <slot />
</a>
