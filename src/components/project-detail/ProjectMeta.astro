---
import TechTag from '../TechTag.astro';

interface Props {
  techstack: string[];
  roles: string[];
  overview: string;
}

const { techstack, roles, overview } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-16 ">
  <div class="md:col-span-2">
    <h2 class="font-heading font-semibold text-heading text-2xl mb-3">
      Overview
    </h2>
    <p class="text-body leading-relaxed">{overview}</p>
  </div>
  <div class="space-y-6">
    <div>
      <p class="text-xs text-subtle font-body tracking-widest uppercase mb-2">
        Role
      </p>
      <ul class="space-y-1">
        {roles.map((role) => <li class="text-sm text-body">{role}</li>)}
      </ul>
    </div>
    <div>
      <p class="text-xs text-subtle font-body tracking-widest uppercase mb-2">
        Tech stack
      </p>
      <div class="flex flex-wrap gap-1.5">
        {techstack.map((tag) => <TechTag label={tag} />)}
      </div>
    </div>
  </div>
</div>
