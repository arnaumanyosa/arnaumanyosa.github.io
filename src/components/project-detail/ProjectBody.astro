---

<div class="project-body mb-16">
  <slot />
</div>

<style>
  .project-body :global(h2) {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-heading);
    font-size: 1.375rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .project-body :global(p) {
    color: var(--color-body);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-body :global(li) {
    color: var(--color-body);
    line-height: 1.75;
    margin-bottom: 0.375rem;
  }

  .project-body :global(ul li) {
    list-style-type: disc;
  }

  .project-body :global(ol li) {
    list-style-type: decimal;
  }

  .project-body :global(strong) {
    color: var(--color-heading);
    font-weight: 600;
  }

  .project-body :global(blockquote) {
    border-left: 4px solid var(--color-heading);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-subtle);
    font-size: 1.5rem;
    line-height: 1.75;
  }
</style>
