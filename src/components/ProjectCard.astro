---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, subtitle, thumbnail } = project.data;
---

<a
  href={`/projects/${project.id}`}
  class="group relative block aspect-4/3 overflow-hidden rounded bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border"
>
  <img
    src={thumbnail}
    alt={title}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
  />

  <!-- Overlay -->
  <div
    class="absolute inset-0 bg-heading/0 group-hover:bg-heading/70 transition-[background-color] duration-300"
  />

  <!-- Content -->
  <div
    class="absolute inset-0 flex flex-col justify-end p-6 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300"
  >
    <h3 class="font-heading font-semibold text-white text-xl leading-snug mb-1">
      {title}
    </h3>
    <p class="font-body text-white/70 text-sm leading-relaxed">{subtitle}</p>
  </div>

  <!-- Arrow -->
  <div
    class="absolute top-4 right-4 opacity-0 -translate-y-1 translate-x-1 group-hover:opacity-100 group-hover:translate-y-0 group-hover:translate-x-0 transition-all duration-300"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="white"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17L17 7" />
      <path d="M7 7h10v10" />
    </svg>
  </div>
</a>
