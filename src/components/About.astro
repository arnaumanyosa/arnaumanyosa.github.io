---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
interface Props {
  about: CollectionEntry<'about'>;
}

const { about } = Astro.props;
const { facts } = about.data;
const { Content } = await render(about);
---

<section id="about" class="py-24 px-6 bg-gray-50/50">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-heading font-semibold text-heading text-3xl mb-8">
      About
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-20">
      <div class="md:col-span-2 space-y-4 text-body leading-relaxed">
        <Content />
      </div>
      <div class="space-y-8">
        {
          facts.map(({ label, value }) => (
            <div>
              <p class="font-heading font-bold text-heading text-4xl mb-1">{value}</p>
              <p class="text-xs text-subtle font-body tracking-widest uppercase">{label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
