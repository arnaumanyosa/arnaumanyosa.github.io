---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SocialIcon from './SocialIcon.astro';

interface Props {
  about: CollectionEntry<'about'>;
}

const { about } = Astro.props;
const { complete_name, role, email, location, social_links } = about.data;
const { Content } = await render(about);
---

<section id="about" class="py-24 px-6 bg-gray-50/50">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-heading font-semibold text-heading text-3xl mb-12">
      About
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="md:col-span-2 space-y-4 text-body leading-relaxed">
        <Content />
      </div>
      <div class="space-y-6">
        <div>
          <p class="text-xs text-subtle font-body tracking-widest uppercase mb-1">
            Name
          </p>
          <p class="text-body text-sm">{complete_name}</p>
        </div>
        <div>
          <p class="text-xs text-subtle font-body tracking-widest uppercase mb-1">
            Role
          </p>
          <p class="text-body text-sm">{role}</p>
        </div>
        <div>
          <p class="text-xs text-subtle font-body tracking-widest uppercase mb-1">
            Location
          </p>
          <p class="text-body text-sm">{location}</p>
        </div>
        <div>
          <p class="text-xs text-subtle font-body tracking-widest uppercase mb-1">
            Contact
          </p>
          <a
            href={`mailto:${email}`}
            class="text-body text-sm hover:text-hover transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border rounded"
          >
            {email}
          </a>
        </div>
        <div>
          <p class="text-xs text-subtle font-body tracking-widest uppercase mb-2">
            Find me
          </p>
          <div class="flex items-center gap-4">
            <SocialIcon
              href={social_links.linkedin}
              platform="linkedin"
              label="LinkedIn profile"
            />
            <SocialIcon
              href={social_links.github}
              platform="github"
              label="GitHub profile"
            />
            <SocialIcon
              href={social_links.dribbble}
              platform="dribbble"
              label="Dribbble profile"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
