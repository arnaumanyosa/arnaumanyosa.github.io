---
interface Props {
  slogan: string;
}

const { slogan } = Astro.props;
const sentences = slogan.split('.').filter(sentence => sentence.trim().length > 0);
---

<section id="hero" class="hero-bg relative min-h-svh">
  <div class="max-w-5xl mx-auto flex flex-col justify-center min-h-svh px-6">
    {sentences.map(sentence => <p class="text-xl sm:text-2xl md:text-3xl leading-relaxed mb-1">{sentence}.</p>)}
  </div>
</section>

<style>
  .hero-bg {
    background-image: url("data:image/svg+xml,%3Csvg width='28' height='28' xmlns='http://www.w3.org/2000/svg'%3E%3Cline x1='0' y1='0' x2='28' y2='0' stroke='%23000' stroke-opacity='0.07' stroke-width='1' stroke-dasharray='2 4'/%3E%3Cline x1='0' y1='0' x2='0' y2='28' stroke='%23000' stroke-opacity='0.07' stroke-width='1' stroke-dasharray='2 4'/%3E%3C/svg%3E");
    background-size: 28px 28px;
  }
</style>
